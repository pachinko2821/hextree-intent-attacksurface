<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntentAttackSurface">
        <activity
            android:name=".MainHextreeActivity"
            android:exported="true"
            android:theme="@style/Theme.IntentAttackSurface"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Flag10Activity"
            android:exported="true"
            android:label="@string/title_activity_flag10"
            android:theme="@style/Theme.IntentAttackSurface"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                 <action android:name="io.hextree.attacksurface.ATTACK_ME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Flag11Activity"
            android:exported="true"
            android:label="@string/title_activity_flag11"
            android:theme="@style/Theme.IntentAttackSurface"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:priority="99">
                <action android:name="io.hextree.attacksurface.ATTACK_ME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Flag12Activity"
            android:exported="true"
            android:label="@string/title_activity_flag12"
            android:theme="@style/Theme.IntentAttackSurface"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="io.hextree.attacksurface.ATTACK_ME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Flag22Activity"
            android:exported="true"
            android:label="@string/title_activity_flag22"
            android:theme="@style/Theme.IntentAttackSurface"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>